# Signs session cookies. Required in production: a random string of at least
# 32 characters, e.g. `openssl rand -base64 48`. Changing it signs everyone out.
AUTH_SESSION_SECRET=

# One PIN per login role. Each must be at least 6 characters on the live site;
# a role whose PIN is blank or shorter can't sign in there.
#   Cashier — ring up sales; signs in at /login
#   Owner   — everything Cashier can do, plus products, inventory, voids and
#             the audit log; signs in at the unlisted /owner page
AUTH_CASHIER_PIN=
AUTH_OWNER_PIN=

# Turso (libSQL) database. For local development a file: URL works with no
# auth token. For a hosted database use the libsql:// URL from
# `turso db show <name> --url` and a token from `turso db tokens create <name>`.
TURSO_DATABASE_URL=file:data/momikie.db
TURSO_AUTH_TOKEN=
